rules_version = '2';

// Owned by this repo — see CLAUDE.md. Deployed by hand from Actions
// (Deploy Firestore rules), never on merge.
service cloud.firestore {
  match /databases/{database}/documents {

    // Who may change menu prices from the editor (menu.pivotdevshop.com/admin).
    // Accounts are email/password users created in Firebase Authentication;
    // being signed in isn't enough, the address has to be on this list.
    function isEditor() {
      return request.auth != null
        && request.auth.token.email in [
          'bturner@tropicalsmoothie.com',
          'bradenturner@gmail.com',
          'braden@pivotdevshop.com'
        ];
    }

    // One price-list document: { name, price } plus an optional sku that must
    // match the document id. Nothing else, so a typo can't add stray fields.
    function isValidItem(sku) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'sku', 'price'])
        && d.keys().hasAll(['name', 'price'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && (!('sku' in d) || d.sku == sku)
        && d.price is number && d.price >= 0 && d.price < 1000;
    }

    // A publish log entry: what each price was before and after, so the
    // editor's "Undo last publish" can put it back. Written in the same batch as
    // the publish itself; the only later change allowed is marking it undone.
    function isValidPublishLog() {
      let d = request.resource.data;
      return d.keys().hasOnly(['at', 'by', 'changes', 'undone'])
        && d.at == request.time
        && d.by == request.auth.token.email
        && d.undone == false
        && d.changes is list && d.changes.size() > 0 && d.changes.size() <= 500;
    }
    function isUndoMark() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['undone', 'undoneAt', 'undoneBy'])
        && resource.data.undone == false && d.undone == true
        && d.undoneAt == request.time
        && d.undoneBy == request.auth.token.email;
    }

    // Public read throughout (except the publish logs, editors only): the screens read prices without signing in, and
    // the editor's preview tab reads drafts the same way. Menu prices are on a
    // screen in a lobby, so nothing here is secret. No deletes from browsers.

    // The default menu — live, and the editor's saved-but-unpublished copy.
    match /menuItems/{sku} {
      allow read: if true;
      allow create, update: if isEditor() && isValidItem(sku);
    }
    match /menuItemsDraft/{sku} {
      allow read: if true;
      allow create, update: if isEditor() && isValidItem(sku);
    }
    match /menuPublishes/{id} {
      allow read: if isEditor();
      allow create: if isEditor() && isValidPublishLog();
      allow update: if isEditor() && isUndoMark();
    }

    // Per-cafe price lists. The cafe document itself is empty; it exists so
    // the editor can list cafes.
    match /cafes/{cafeId} {
      allow read: if true;
      allow create: if isEditor()
        && cafeId.matches('^[A-Za-z0-9_-]{1,40}$')
        && request.resource.data.keys().size() == 0;

      match /items/{sku} {
        allow read: if true;
        allow create, update: if isEditor() && isValidItem(sku);
      }
      match /draft/{sku} {
        allow read: if true;
        allow create, update: if isEditor() && isValidItem(sku);
      }
      match /publishes/{id} {
        allow read: if isEditor();
        allow create: if isEditor() && isValidPublishLog();
        allow update: if isEditor() && isUndoMark();
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
